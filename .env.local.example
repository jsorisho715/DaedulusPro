# Copy to .env.local and fill in. Values prefixed with VITE_ are exposed
# to the browser bundle by Vite — never put secrets here.

# Default leaves it empty so the api helper falls back to '/api', which
# works for both `npm run dev` (proxied) and Vercel production.
VITE_API_BASE_URL=

# Add server-only secrets to .env (without VITE_ prefix) — those are only
# available inside Vercel Functions in /api, never in the browser.
